<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- BYOS: Production hubs should use HTTPS; local LAN HTTP hubs remain reachable when user configures a LAN URL. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

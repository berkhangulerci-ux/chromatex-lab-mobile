# Copy this file to `keystore.properties` (gitignored) before building Play Store release bundle (.aab)
# Generate an upload key once:
#   keytool -genkeypair -v -keystore playstore-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Then build signed Android App Bundle:
#   .\gradlew.bat bundlePlaystoreRelease

storeFile=playstore-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
